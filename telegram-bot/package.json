{
  "name": "@bots/addsport",
  "version": "0.1.0",
  "private": true,
  "description": "Sports + nutrition micro-coach Telegram bot, hosted on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply addsport_db --local",
    "migrate:remote": "wrangler d1 migrations apply addsport_db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^5.6.0",
    "vitest": "~2.1.0",
    "wrangler": "^3.78.0"
  }
}
