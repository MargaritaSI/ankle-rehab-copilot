# Nebius Token Factory (required) — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model tiers (defaults shown)
# NEMOTRON_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_STRONG=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
# Tavily (optional) — web fallback when the library is silent
TAVILY_API_KEY=
# Where the prebuilt paper index is downloaded from if corpus/index/ is empty
# INDEX_BASE_URL=https://github.com/MargaritaSI/ankle-rehab-copilot/releases/download/index-v1/
# Daily token budget for the demo (all Token Factory calls, chat + embeddings); 0 = unlimited
DAILY_TOKEN_BUDGET=1500000
